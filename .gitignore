# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turbo
.turbo

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/app.db
/generated/prisma
/lib/generated/prisma

# archive directories
archive
./archive

# monorepo specific
apps/*/node_modules
apps/*/.next
apps/*/out
apps/*/build
apps/*/.turbo
packages/*/node_modules
packages/*/dist
packages/*/build
packages/*/.turbo

# lock files (keep only at root)
apps/*/package-lock.json
apps/*/yarn.lock
apps/*/pnpm-lock.yaml
packages/*/package-lock.json
packages/*/yarn.lock
packages/*/pnpm-lock.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db